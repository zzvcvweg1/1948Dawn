function addRunningMateColumn() {
    const resultsTableHolder = document.getElementById("overall_details_container");

    if (!resultsTableHolder) {
        return;
    }

    const resultsTable = resultsTableHolder.querySelector("table");

    if (!resultsTable) {
        return;
    }

    for (let i = 0; i < resultsTable.rows.length; i++) {
        const row = resultsTable.rows[i];

        if (row.getAttribute("data-vp-added") == "true") {
            continue;
        }

        if (i == 0) {
            const cell = row.cells[0].cloneNode(false);
            cell.textContent = "Running Mate";
            cell.removeAttribute("id");
            cell.id = "running-mate";
            row.insertBefore(cell, row.cells[1]);
            row.setAttribute("data-vp-added", "true");
            continue;
        }

        if (!row.cells[0]) {
            continue;
        }

        let name = row.cells[0].innerText.replaceAll("-", "").replace(/\s+/g, " ").trim();

        if (!Object.prototype.hasOwnProperty.call(vpTable, name)) {
            continue;
        }

        const cell = row.insertCell(1);
        cell.innerHTML = vpTable[name];
        row.setAttribute("data-vp-added", "true");
    }
}

