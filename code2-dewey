let dawnDeweyTooltipBox = document.getElementById("dawn-dewey-tooltip");
if (!dawnDeweyTooltipBox) {
    dawnDeweyTooltipBox = document.createElement("div");
    dawnDeweyTooltipBox.id = "dawn-dewey-tooltip";
    dawnDeweyTooltipBox.setAttribute("role", "tooltip");
    document.body.appendChild(dawnDeweyTooltipBox);
}

let dawnDeweyTooltipCurrentTrigger = null;
let dawnDeweyTooltipShowTimer = null;

function dawnDeweyTooltipPosition(trigger) {
    if (!trigger || !trigger.isConnected || !dawnDeweyTooltipBox) return;

    const triggerRect = trigger.getBoundingClientRect();
    const tipRect = dawnDeweyTooltipBox.getBoundingClientRect();
    const viewportPadding = 10;
    const gap = 8;

    let left = triggerRect.left + (triggerRect.width / 2) - (tipRect.width / 2);
    left = Math.max(
        viewportPadding,
        Math.min(left, window.innerWidth - tipRect.width - viewportPadding)
    );

    let top = triggerRect.top - tipRect.height - gap;

    if (top < viewportPadding) {
        top = triggerRect.bottom + gap;
    }

    if (top + tipRect.height > window.innerHeight - viewportPadding) {
        top = Math.max(
            viewportPadding,
            window.innerHeight - tipRect.height - viewportPadding
        );
    }

    dawnDeweyTooltipBox.style.left = `${Math.round(left)}px`;
    dawnDeweyTooltipBox.style.top = `${Math.round(top)}px`;
}

function dawnDeweyTooltipRender(trigger) {
    if (!dawnDeweyTooltipSideIsActive()) return;

    const entryIndex = Number(trigger.dataset.dawnDeweyTooltipIndex);
    const entry = dawnDeweyTooltips[entryIndex];
    if (!entry) return;

    dawnDeweyTooltipCurrentTrigger = trigger;
    dawnDeweyTooltipBox.replaceChildren();

    if (entry.image) {
        const media = document.createElement("div");
        media.className = "dawn-dewey-tooltip-media";

        const image = document.createElement("img");
        image.src = entry.image;
        image.alt = "";
        image.decoding = "async";
        image.loading = "eager";

        image.addEventListener("load", () => {
            if (dawnDeweyTooltipCurrentTrigger === trigger) {
                dawnDeweyTooltipPosition(trigger);
            }
        });

        image.addEventListener("error", () => {
            media.remove();
            if (dawnDeweyTooltipCurrentTrigger === trigger) {
                dawnDeweyTooltipPosition(trigger);
            }
        });

        media.appendChild(image);
        dawnDeweyTooltipBox.appendChild(media);
    }

    const copy = document.createElement("div");
    copy.className = "dawn-dewey-tooltip-copy";
    copy.textContent = entry.description;
    dawnDeweyTooltipBox.appendChild(copy);

    dawnDeweyTooltipBox.classList.add("dawn-dewey-tooltip-visible");
    dawnDeweyTooltipPosition(trigger);
}

function dawnDeweyTooltipScheduleShow(trigger) {
    clearTimeout(dawnDeweyTooltipShowTimer);
    dawnDeweyTooltipShowTimer = setTimeout(() => {
        if (trigger.matches(":hover") && dawnDeweyTooltipSideIsActive()) {
            dawnDeweyTooltipRender(trigger);
        }
    }, 180);
}

function dawnDeweyTooltipHide() {
    clearTimeout(dawnDeweyTooltipShowTimer);
    dawnDeweyTooltipCurrentTrigger = null;
    dawnDeweyTooltipBox.classList.remove("dawn-dewey-tooltip-visible");
}

function dawnDeweyTooltipIsWordChar(character) {
    return !!character && /[A-Za-z0-9]/.test(character);
}

function dawnDeweyTooltipWrapTextNode(textNode) {
    if (!textNode || !textNode.nodeValue || !textNode.parentElement) return;
    if (textNode.parentElement.closest(".dawn-dewey-tooltip-term")) return;
    if (textNode.parentElement.closest("#dawn-dewey-tooltip")) return;

    const sourceText = textNode.nodeValue;
    dawnDeweyTooltipRegex.lastIndex = 0;

    let match;
    let lastIndex = 0;
    let changed = false;
    const fragment = document.createDocumentFragment();

    while ((match = dawnDeweyTooltipRegex.exec(sourceText)) !== null) {
        const term = match[0];
        const start = match.index;
        const end = start + term.length;
        const before = sourceText[start - 1];
        const after = sourceText[end];

        if (dawnDeweyTooltipIsWordChar(before) || dawnDeweyTooltipIsWordChar(after)) {
            continue;
        }

        changed = true;

        if (start > lastIndex) {
            fragment.appendChild(document.createTextNode(sourceText.slice(lastIndex, start)));
        }

        const trigger = document.createElement("span");
        trigger.className = "dawn-dewey-tooltip-term";
        trigger.dataset.dawnDeweyTooltipIndex = String(
            dawnDeweyTooltipTermIndex.get(term)
        );
        trigger.textContent = term;
        fragment.appendChild(trigger);

        lastIndex = end;
    }

    if (!changed) return;

    if (lastIndex < sourceText.length) {
        fragment.appendChild(document.createTextNode(sourceText.slice(lastIndex)));
    }

    textNode.parentNode.replaceChild(fragment, textNode);
}

function dawnDeweyTooltipScanContainer(container) {
    if (!container || !dawnDeweyTooltipSideIsActive()) return;

    const walker = document.createTreeWalker(
        container,
        NodeFilter.SHOW_TEXT,
        {
            acceptNode(node) {
                if (!node.nodeValue || !node.nodeValue.trim()) {
                    return NodeFilter.FILTER_REJECT;
                }

                const parent = node.parentElement;
                if (!parent) return NodeFilter.FILTER_REJECT;
                if (parent.closest(".dawn-dewey-tooltip-term")) {
                    return NodeFilter.FILTER_REJECT;
                }
                if (parent.closest("#dawn-dewey-tooltip")) {
                    return NodeFilter.FILTER_REJECT;
                }

                dawnDeweyTooltipRegex.lastIndex = 0;
                return dawnDeweyTooltipRegex.test(node.nodeValue)
                    ? NodeFilter.FILTER_ACCEPT
                    : NodeFilter.FILTER_REJECT;
            }
        }
    );

    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(dawnDeweyTooltipWrapTextNode);
}

function dawnDeweyTooltipScanVisibleText() {
    if (!dawnDeweyTooltipSideIsActive()) {
        dawnDeweyTooltipHide();
        return;
    }

    document.querySelectorAll(
        ".inner_window_question h3, " +
        "#question_form label, " +
        "#visit_content p, " +
        "#feedback_content p"
    ).forEach(dawnDeweyTooltipScanContainer);
}

let dawnDeweyTooltipScanQueued = false;
function dawnDeweyTooltipQueueScan() {
    if (dawnDeweyTooltipScanQueued) return;

    dawnDeweyTooltipScanQueued = true;
    requestAnimationFrame(() => {
        dawnDeweyTooltipScanQueued = false;
        dawnDeweyTooltipScanVisibleText();

        if (
            dawnDeweyTooltipCurrentTrigger &&
            !dawnDeweyTooltipCurrentTrigger.isConnected
        ) {
            dawnDeweyTooltipHide();
        }
    });
}

document.addEventListener("mouseover", event => {
    const trigger = event.target.closest
        ? event.target.closest(".dawn-dewey-tooltip-term")
        : null;

    if (!trigger || !dawnDeweyTooltipSideIsActive()) return;
    if (event.relatedTarget && trigger.contains(event.relatedTarget)) return;

    dawnDeweyTooltipScheduleShow(trigger);
});

document.addEventListener("mouseout", event => {
    const trigger = event.target.closest
        ? event.target.closest(".dawn-dewey-tooltip-term")
        : null;

    if (!trigger) return;
    if (event.relatedTarget && trigger.contains(event.relatedTarget)) return;

    dawnDeweyTooltipHide();
});

window.addEventListener("resize", () => {
